<odoo>
    <record id="hr_hospital_disease_tree" model="ir.ui.view">
        <field name="name">hr.hospital.disease.tree</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="icd10_code"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="danger_level"/>
                <field name="is_contagious"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Disease Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="icd10_code"/>
                            <field name="parent_id"/>
                            <field name="danger_level"/>
                            <field name="is_contagious"/>
                        </group>
                        <group string="Spread Regions">
                            <field name="region_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Disease description..."/>
                        </page>
                        <page string="Symptoms">
                            <field name="symptoms" placeholder="Disease symptoms..."/>
                        </page>
                        <page string="Child Diseases">
                            <field name="child_ids">
                                <list>
                                    <field name="icd10_code"/>
                                    <field name="name"/>
                                    <field name="danger_level"/>
                                    <field name="is_contagious"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_disease_window" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_disease"
              action="action_hr_hospital_disease_window"
              parent="hr_hospital_menu_other"
              name="Diseases" sequence="200"/>
</odoo>

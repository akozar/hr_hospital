<odoo>
    <record id="hr_hospital_doctor_specialty_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.specialty.tree</field>
        <field name="model">hr.hospital.doctor.specialty</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_specialty_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.specialty.form</field>
        <field name="model">hr.hospital.doctor.specialty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Doctors">
                            <field name="doctor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="license_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_doctor_specialty_window" model="ir.actions.act_window">
        <field name="name">Doctor Specialties</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor.specialty</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_doctor_specialty"
              action="action_hr_hospital_doctor_specialty_window"
              parent="hr_hospital_menu_doctors"
              name="Specialties" sequence="100"/>
</odoo>

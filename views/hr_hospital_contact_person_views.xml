<odoo>
    <record id="hr_hospital_contact_person_tree" model="ir.ui.view">
        <field name="name">hr.hospital.contact.person.tree</field>
        <field name="model">hr.hospital.contact.person</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="gender"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_contact_person_form" model="ir.ui.view">
        <field name="name">hr.hospital.contact.person.form</field>
        <field name="model">hr.hospital.contact.person</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="surname"/>
                            <field name="first_name"/>
                            <field name="patronymic"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <group string="Contact Information">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="country_id"/>
                            <field name="lang_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_contact_person_window" model="ir.actions.act_window">
        <field name="name">Contact Persons</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.contact.person</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_contact_person"
              action="action_hr_hospital_contact_person_window"
              parent="hr_hospital_menu_other"
              name="Contact Persons" sequence="100"/>
</odoo>

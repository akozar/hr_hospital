<odoo>
    <record id="hr_hospital_patient_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.visit.tree</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="scheduled_time"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="visit_type"/>
                <field name="state"/>
                <field name="cost"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.visit.form</field>
        <field name="model">hr.hospital.patient.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group string="Visit Information">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="visit_type"/>
                            <field name="scheduled_time"/>
                            <field name="actual_time" readonly="state != 'done'"/>
                        </group>
                        <group string="Financial">
                            <field name="cost"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnoses">
                            <field name="diagnosis_ids">
                                <list editable="bottom">
                                    <field name="disease_id"/>
                                    <field name="severity"/>
                                    <field name="description"/>
                                    <field name="is_approved"/>
                                    <field name="approved_by_id"/>
                                    <field name="approval_date"/>
                                    <button name="action_approve"
                                            type="object"
                                            string="Approve"
                                            icon="fa-check"
                                            class="btn-success"
                                            invisible="is_approved"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendations"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient_visit_window" model="ir.actions.act_window">
        <field name="name">Patient Visits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_patient_visit"
              action="action_hr_hospital_patient_visit_window"
              parent="hr_hospital_menu_other"
              name="Visits" sequence="200"/>
</odoo>

<odoo>
    <record id="hr_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree ()</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="doctor_id"/>
                <field name="description"/>
                <field name="res_partner_id"/>
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form ()</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="surname"/>
                            <field name="first_name"/>
                            <field name="patronymic"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="passport_data"/>
                        </group>
                        <group string="Contact Information">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="country_id"/>
                            <field name="lang_id"/>
                            <field name="contact_person_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Medical Information">
                            <field name="doctor_id"/>
                            <field name="blood_group"/>
                            <field name="allergies"/>
                            <field name="description"/>
                        </group>
                        <group string="Insurance">
                            <field name="insurance_company_id"/>
                            <field name="insurance_policy_number"/>
                            <field name="res_partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctor History">
                            <field name="doctor_history_ids">
                                <list>
                                    <field name="doctor_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="reason"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient_window" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_hospital_menu_patient"
              action="action_hr_hospital_patient_window"
              parent="hr_hospital_menu_patients"
              name="Patient" sequence="200"/>
</odoo>

<odoo>
    <record id="reschedule_visit_wizard_form" model="ir.ui.view">
        <field name="name">reschedule.visit.wizard.form</field>
        <field name="model">reschedule.visit.wizard</field>
        <field name="arch" type="xml">
            <form string="Reschedule Visit">
                <group string="Current Visit">
                    <field name="visit_id" readonly="1"/>
                    <field name="patient_id"/>
                    <field name="current_doctor_id"/>
                    <field name="current_scheduled_time"/>
                </group>
                <group string="New Schedule">
                    <field name="new_doctor_id"/>
                    <field name="new_date"/>
                    <field name="new_time" widget="float_time"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_reschedule" type="object"
                            string="Reschedule" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action triggered from Visit form/list -->
    <record id="action_reschedule_visit_wizard" model="ir.actions.act_window">
        <field name="name">Reschedule Visit</field>
        <field name="res_model">reschedule.visit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient_visit"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>

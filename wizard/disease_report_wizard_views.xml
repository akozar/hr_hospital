<odoo>
    <record id="disease_report_wizard_form" model="ir.ui.view">
        <field name="name">disease.report.wizard.form</field>
        <field name="model">disease.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Disease Report">
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Report Options">
                        <field name="report_type"/>
                        <field name="group_by"/>
                    </group>
                </group>
                <group>
                    <group string="Filters">
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="disease_ids" widget="many2many_tags"/>
                        <field name="country_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" type="object"
                            string="Generate Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu action to open wizard -->
    <record id="action_disease_report_wizard" model="ir.actions.act_window">
        <field name="name">Disease Report</field>
        <field name="res_model">disease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item under Reports -->
    <menuitem id="hr_hospital_menu_disease_report"
              action="action_disease_report_wizard"
              parent="hr_hospital_menu_reports"
              name="Disease Report"
              sequence="100"/>
</odoo>

<odoo>
    <record id="doctor_schedule_wizard_form" model="ir.ui.view">
        <field name="name">doctor.schedule.wizard.form</field>
        <field name="model">doctor.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill Doctor Schedule">
                <group>
                    <field name="doctor_id"/>
                    <field name="week_start"/>
                    <field name="num_weeks"/>
                    <field name="schedule_pattern"/>
                </group>
                <group string="Working Days">
                    <group>
                        <field name="monday"/>
                        <field name="tuesday"/>
                        <field name="wednesday"/>
                        <field name="thursday"/>
                    </group>
                    <group>
                        <field name="friday"/>
                        <field name="saturday"/>
                        <field name="sunday"/>
                    </group>
                </group>
                <group string="Working Hours">
                    <group>
                        <field name="time_from" widget="float_time"/>
                        <field name="time_to" widget="float_time"/>
                    </group>
                    <group>
                        <field name="break_from" widget="float_time"/>
                        <field name="break_to" widget="float_time"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_schedule" type="object"
                            string="Generate Schedule" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action triggered from Doctor form/list -->
    <record id="action_doctor_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Fill Schedule</field>
        <field name="res_model">doctor.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
